rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sectors current state
    match /sectors/{sectorId} {
      allow read, write: if true;
    }
    
    // Staff current state
    match /staff/{staffId} {
      allow read, write: if true;
    }
    
    // Occurrences collection
    match /occurrences/{occurrenceId} {
      allow read, write: if true;
    }
    
    // Historical shift records
    match /shift_records/{recordId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
